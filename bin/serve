#!/usr/bin/env ruby
require 'webrick'
root = File.expand_path('..', __dir__)
abort 'Build first: ruby bin/build' unless Dir.exist?(File.join(root, '_site'))
server = WEBrick::HTTPServer.new(Port: Integer(ENV.fetch('PORT', '4000')), BindAddress: '127.0.0.1', DocumentRoot: File.join(root, '_site'))
trap('INT') { server.shutdown }
trap('TERM') { server.shutdown }
puts 'Preview: http://127.0.0.1:' + server.config[:Port].to_s
server.start
