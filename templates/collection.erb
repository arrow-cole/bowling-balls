<section class="intro"><div><p class="eyebrow">MY ARSENAL / <%= @path == 'tour.html' ? 'TOURNAMENT READY' : 'THE COLLECTION' %></p><h1><%= @path == 'tour.html' ? 'Packed for the lanes.' : 'Find the right roll.' %></h1><p class="lede"><%= @path == 'tour.html' ? 'The current lineup in my tournament bag.' : 'My bowling ball collection. Every coverstock, core, and detail in one place.' %></p></div><div class="stat"><strong><%= @selected.size %></strong><span><%= @path == 'tour.html' ? 'IN THE BAG' : 'ACTIVE BALLS' %></span></div></section>
<section aria-label="Bowling balls"><div class="toolbar"><div><h2><%= @title %></h2><p id="result-count" aria-live="polite"><%= @selected.size %> balls in the lineup</p></div><div class="filters"><label><span class="sr-only">Search balls</span><input id="search" type="search" placeholder="Search the collection…"></label><label><span class="sr-only">Filter by brand</span><select id="brand"><option value="">All brands</option><% @selected.map { |b| b['brand'] }.uniq.sort.each do |brand| %><option><%= h(brand) %></option><% end %></select></label></div></div>
<div class="ball-grid"><% @selected.each_with_index do |ball,i| %><article class="ball-card" data-name="<%= h(ball['name'].downcase) %>" data-brand="<%= h(ball['brand']) %>"><a href="<%= url(ball['link']) %>"><div class="ball-image"><span class="card-index"><%= '%02d' % (i+1) %></span><img src="<%= url(ball['img']) %>" alt="<%= h(ball['name']) %>" loading="lazy"></div><div class="card-copy"><p class="eyebrow"><%= h(ball['brand']) %></p><h3><%= h(ball['name']) %><span aria-hidden="true">↗</span></h3><p class="card-meta"><%= h(ball['specs']['Weight']) %> <span>·</span> <%= h(ball['specs']['Core Shape']) %></p></div></a></article><% end %></div>
<p id="empty" hidden>No balls match. Try another name or brand.</p></section>
